# Nusxa oling: cp .env.example .env — va qiymatlarni to'ldiring.

# Telegram bot tokeni (@BotFather beradi)
BOT_TOKEN=

# PostgreSQL. Docker Compose ichida POSTGRES_HOST va POSTGRES_PORT avtomatik
# "postgres:5432" ga almashtiriladi; bu yerdagi qiymat lokal ishga tushirish uchun.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=golli
POSTGRES_USER=golli
POSTGRES_PASSWORD=

# Redis. Docker Compose ichida avtomatik "redis://redis:6379/0" bo'ladi.
REDIS_URL=redis://localhost:6379/0

# Futbol ma'lumotlari provayderlari
HIGHLIGHTLY_API_KEY=
API_FOOTBALL_KEY=

# Klub logotiplari (matn ichidagi maxsus emoji). Emoji to'plami egasining Telegram ID'si —
# bot egasi; u botga /start bosgan bo'lishi kerak. Bo'sh qolsa, logotiplar ko'rsatilmaydi.
# Bot maxsus emojini faqat egasida Telegram Premium bo'lsa ishlata oladi.
# Bitta bot uchun faqat bitta joyda (serverda) yoqing: worker to'plamni o'z bazasiga moslaydi.
# EMOJI_OWNER_ID=

DEFAULT_LOCALE=uz
LOG_LEVEL=INFO
